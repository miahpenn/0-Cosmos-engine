diff --git a/engine/true_cmc_reference.py b/engine/true_cmc_reference.py
index da8e094..5cbac98 100644
--- a/engine/true_cmc_reference.py
+++ b/engine/true_cmc_reference.py
@@ -30,8 +30,13 @@ def cmc_lapse(g,s,fields,outer_frac=.20):
     # D^2 alpha + c alpha' - Q/inv alpha = -Kdot/inv
     A=np.zeros((3,n)); rhs=np.zeros(n)
     m=Q/inv; bvec=-kd/inv
-    # regular center: alpha'(0)=0
-    A[1,0]=1.0; A[0,1]=-1.0
+    # Regular center. The lapse is even on the cell-centred grid, so cell 0 uses
+    # the interior three-point equation with the even reflection ghost
+    # alpha[-1] = alpha[0] (the grid's parity-ghost convention). The former row
+    # alpha[0] - alpha[1] = 0 is not satisfied by a smooth even lapse and left an
+    # O(h^2) kink at the origin; same repair as engine/cmc_gauge.py (#436).
+    c0=c[0]/(2*h)
+    A[1,0]=-1/h**2-c0-m[0]; A[0,1]=1/h**2+c0; rhs[0]=bvec[0]
     for i in range(1,n-1):
         cim=c[i]/(2*h)
         A[2,i-1]=1/h**2-cim
